# ==============================================================================
# CONFIGURATION NUBO - ENVIRONNEMENT GLOBAL
# ==============================================================================

# --- IDENTITÉ DU SERVEUR (Pour le Scaling Horizontal) ---
NODE_ID=1
SERVER_ROLE=monolith     # Options: monolith, api_node, db_master, worker_node

# --- APPLICATION ---
PORT=8080
CLEAN_DB_ON_STARTUP=false

# --- SÉCURITÉ & TOKENS (Générer des chaînes de 64 caractères hexadécimaux en prod) ---
JWT_SECRET=f3b58498f32c1c981b21..._METTRE_UNE_VRAIE_CLE_LONGUE_ICI
HMAC_SECRET=9d8a7c6b5e4f3a2b1c0d..._METTRE_UNE_VRAIE_CLE_LONGUE_ICI
WATERMARK_SECRET_KEY=cle_secrete_inter_services_nubo_2026

# --- WORKERS (Tuning de l'Asynchronisme) ---
WORKER_MAX_BATCH_SIZE=5000
WORKER_MIN_BACKOFF_MS=50
WORKER_MAX_BACKOFF_MS=1000

# ==============================================================================
# TOPOLOGIE RÉSEAU (Remplacer par les IP privées Scaleway en production distribuée)
# Exemple: Remplacer "postgres" par "10.0.5.12" sur les serveurs API
# ==============================================================================

# --- POSTGRESQL (L3 - Cold Storage) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nubo_admin
POSTGRES_PASSWORD=Remplacer_Par_Un_Mot_De_Passe_Robuste_64_Chars
POSTGRES_DB=nubo
DB_DSN=host=${POSTGRES_HOST} user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_DB} port=${POSTGRES_PORT} sslmode=disable

# --- MONGODB (L2 - Warm Storage) ---
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=nubo
MONGO_ROOT_USER=nubo_mongo_admin
MONGO_ROOT_PASSWORD=Remplacer_Par_Un_Mot_De_Passe_Robuste_64_Chars

# --- REDIS (L1 - Hot Storage & Message Broker) ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=Remplacer_Par_Un_Mot_De_Passe_Robuste_64_Chars
REDIS_MAXMEMORY=4gb
REDIS_CONTAINER_LIMIT=4.5gb

# --- MINIO (L4 - Object Storage S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=nubo-bucket
MINIO_ROOT_USER=nubo_storage_admin
MINIO_ROOT_PASSWORD=Remplacer_Par_Un_Mot_De_Passe_Robuste_64_Chars
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# --- MICRO-SERVICES ---
# L'URL du service de tatouage. En prod distribuée, ce sera l'IP du serveur Watermark.
WATERMARK_API_URL=http://watermark:8080

# ==============================================================================
# INTERFACES D'ADMINISTRATION (UI)
# ==============================================================================
PGADMIN_EMAIL=admin@nubo.com
PGADMIN_PASSWORD=Remplacer_Par_Un_Mot_De_Passe_Robuste_64_Chars
MONGO_UI_USER=admin
MONGO_UI_PASSWORD=Remplacer_Par_Un_Mot_De_Passe_Robuste_64_Chars
REDIS_UI_USER=admin
REDIS_UI_PASSWORD=Remplacer_Par_Un_Mot_De_Passe_Robuste_64_Chars